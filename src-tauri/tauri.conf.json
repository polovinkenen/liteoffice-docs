{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteOffice Docs",
  "version": "0.1.0",
  "identifier": "app.liteoffice.docs",
  "mainBinaryName": "liteoffice-docs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiteOffice Docs",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Редактор документов",
    "longDescription": "Кроссплатформенный редактор документов с поддержкой DOCX, RTF, Markdown, HTML и экспортом в PDF.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "name": "LiteOfficeDocs.Word",
        "description": "Word document",
        "ext": ["docx"],
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "contentTypes": ["org.openxmlformats.wordprocessingml.document"],
        "role": "Editor",
        "rank": "Default"
      },
      {
        "name": "LiteOfficeDocs.Rtf",
        "description": "Rich Text Format document",
        "ext": ["rtf"],
        "mimeType": "application/rtf",
        "contentTypes": ["public.rtf"],
        "role": "Editor",
        "rank": "Default"
      },
      {
        "name": "LiteOfficeDocs.Text",
        "description": "Text document",
        "ext": ["txt"],
        "mimeType": "text/plain",
        "contentTypes": ["public.plain-text"],
        "role": "Editor",
        "rank": "Default"
      },
      {
        "name": "LiteOfficeDocs.Markdown",
        "description": "Markdown document",
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "contentTypes": ["net.daringfireball.markdown"],
        "role": "Editor",
        "rank": "Default"
      },
      {
        "name": "LiteOfficeDocs.Html",
        "description": "HTML document",
        "ext": ["html", "htm"],
        "mimeType": "text/html",
        "contentTypes": ["public.html"],
        "role": "Editor",
        "rank": "Default"
      }
    ]
  }
}
